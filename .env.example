# ==============================================================================
# Prava V2 - Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# DO NOT commit real secrets or credentials to git.

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & Project Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret key; NEVER expose to client bundle
SUPABASE_SECRET_KEY=your-supabase-secret-key


# ------------------------------------------------------------------------------
# 2. Database Connections - PostgreSQL via Supabase / Prisma ORM
# ------------------------------------------------------------------------------
# Pooled connection string (Transaction mode, port 6543) for application runtime
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection string (Session mode, port 5432) for Prisma migrations
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI Provider - Google Gemini * Flash 
# ------------------------------------------------------------------------------
# Server-only API Key for Gemini API integration
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Unsplash API (Trip Cover Image Search)
# ------------------------------------------------------------------------------
# Server-only Unsplash Access Key for destination and tour-vibe photography
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ------------------------------------------------------------------------------
# 6. OpenWeather API (Travel Essentials - Live Forecasts & Hourly Data)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Free or OneCall tier)
OPENWEATHER_API_KEY=your-openweather-api-key

# ------------------------------------------------------------------------------
# 7. Polar Subscription Billing (Sandbox Environment)
# ------------------------------------------------------------------------------
# Polar Organization Access Token (OAT) from Sandbox dashboard (Settings -> Access Tokens)
# NEVER expose this or prefix with NEXT_PUBLIC_
POLAR_ACCESS_TOKEN=polar_oat_your_sandbox_access_token

# Polar Product ID for Prava Pro created in Polar Sandbox Products
POLAR_PRODUCT_ID=your-polar-product-id

# Polar Webhook Secret from Polar Sandbox Webhooks endpoint configuration
# Used for verifying incoming Standard Webhooks signatures cryptographically
POLAR_WEBHOOK_SECRET=polar_whsec_your_webhook_secret

# Polar Environment: "sandbox" for development/testing, "production" for live
POLAR_SERVER=sandbox

# Optional: Polar organization slug (used for fallback customer portal URLs: https://polar.sh/<org-slug>/portal)
POLAR_ORGANIZATION_SLUG=your-polar-organization-slug

# ------------------------------------------------------------------------------
# 8. OpenCode Zen API (Free Secondary Model Fallback Cascade)
# ------------------------------------------------------------------------------
# API Key for OpenCode Zen (https://opencode.ai/zen)
# Provides free-tier access to models (e.g. nemotron-3.5-lightning-free, minimax-m2.5-free)
# Used as secondary fallback when OpenRouter daily free tier is exhausted
OPENCODE_API_KEY=your_opencode_zen_api_key
