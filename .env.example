# ==============================================================================
# Prava AI V2 - Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# DO NOT commit real secrets or credentials to git.

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & Project Keys (Phase 3)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret key; NEVER expose to client bundle
SUPABASE_SECRET_KEY=your-supabase-secret-key


# ------------------------------------------------------------------------------
# 2. Database Connections - PostgreSQL via Supabase / Prisma ORM (Phase 4)
# ------------------------------------------------------------------------------
# Pooled connection string (Transaction mode, port 6543) for application runtime
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection string (Session mode, port 5432) for Prisma migrations
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. AI Provider - Google Gemini 2.5 Flash (Phase 8)
# ------------------------------------------------------------------------------
# Server-only API Key for Gemini API integration
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Cloudinary File Storage (Phase 6 / Phase 9)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 5. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Unsplash API (Trip Cover Image Search)
# ------------------------------------------------------------------------------
# Server-only Unsplash Access Key for destination and tour-vibe photography
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

